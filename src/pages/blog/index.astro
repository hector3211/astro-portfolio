---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-astro";

export const prerender = true;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Blog | Hector Oropesa"
  description="Notes on software, infrastructure, and systems by Hector Oropesa."
>
  <section
    class="portfolio-shell pb-16 pt-14 sm:pb-24 sm:pt-20 lg:pt-28"
    aria-labelledby="writing-title"
  >
    <header class="mb-8 sm:mb-12">
      <p class="portfolio-label">Blog</p>
      <div class="portfolio-heading !mb-0">
        <h1
          id="writing-title"
          class="portfolio-title [--portfolio-title-size:clamp(3.75rem,9vw,9rem)]"
        >
          Writing<span class="text-muted-foreground">.</span>
        </h1>
        <p>
          Notes from building software, running infrastructure, and keeping
          systems working.
        </p>
      </div>
    </header>

    {
      posts.length > 0 ? (
        <ul class="divide-y border-y">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 px-1 py-5 sm:px-3 sm:py-6 md:grid-cols-[7.5rem_minmax(0,1fr)_auto] md:gap-x-7"
              >
                <time
                  datetime={post.data.date.toISOString()}
                  class="portfolio-label col-start-1 row-start-1 md:self-start md:pt-1.5"
                >
                  {dateFormat.format(post.data.date)}
                </time>
                <div class="col-start-1 row-start-2 md:col-start-2 md:row-start-1">
                  <h2 class="text-xl font-medium leading-tight tracking-[-0.045em] group-hover:text-[var(--portfolio-accent)] sm:text-2xl lg:text-[1.625rem]">
                    {post.data.title}
                  </h2>
                  <p class="mt-1.5 max-w-[65ch] text-sm leading-relaxed text-muted-foreground">
                    {post.data.description}
                  </p>
                </div>
                <ArrowUpRight
                  aria-hidden="true"
                  class="col-start-2 row-start-2 size-4 text-[var(--portfolio-accent)] md:col-start-3 md:row-start-1"
                />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="border-t py-6 text-sm text-muted-foreground">
          No posts yet. Check back soon.
        </p>
      )
    }
  </section>
</Layout>
