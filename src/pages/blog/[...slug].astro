---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft, ArrowUpRight } from "lucide-astro";

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      nextPost: posts[index - 1],
      previousPost: posts[index + 1],
    },
  }));
}

const { post, nextPost, previousPost } = Astro.props;
const { Content } = await render(post);

const siteUrl = "https://hectorcodes.dev";
const canonicalUrl = new URL(`/blog/${post.id}`, siteUrl).href;
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const adjacentPosts = [
  { label: "Newer post", entry: nextPost },
  { label: "Older post", entry: previousPost },
];
---

<Layout
  title={`${post.data.title} | Hector Oropesa`}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogType="article"
  publishedDate={post.data.date.toISOString()}
>
  <article class="portfolio-shell py-10 sm:py-14">
    <div class="mx-auto max-w-3xl">
      <header class="mb-9 border-b pb-8 sm:mb-12 sm:pb-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground"
        >
          <ArrowLeft aria-hidden="true" class="size-4" /> All field notes
        </a>
        <p class="portfolio-label mt-8 sm:mt-12">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        </p>
        <h1 class="portfolio-title mt-4 text-balance sm:mt-5">
          {post.data.title}
        </h1>
        <p
          class="mt-5 max-w-[58ch] text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
          {post.data.description}
        </p>
      </header>

      <div
        class="blog-prose prose max-w-none sm:prose-lg prose-headings:font-medium prose-headings:tracking-tight prose-a:text-[var(--portfolio-accent)] prose-a:underline-offset-4"
      >
        <Content />
      </div>

      {
        (nextPost || previousPost) && (
          <nav
            aria-label="More blog posts"
            class="mt-12 grid gap-x-8 border-y sm:mt-16 sm:grid-cols-2"
          >
            {adjacentPosts.map(
              ({ label, entry }) =>
                entry && (
                  <a
                    href={`/blog/${entry.id}`}
                    class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 py-5 [&+a]:border-t sm:[&+a]:border-t-0"
                  >
                    <span>
                      <span class="portfolio-label block">{label}</span>
                      <span class="mt-1.5 block text-lg font-medium leading-tight tracking-tight group-hover:text-[var(--portfolio-accent)]">
                        {entry.data.title}
                      </span>
                    </span>
                    <ArrowUpRight
                      aria-hidden="true"
                      class="size-4 text-[var(--portfolio-accent)]"
                    />
                  </a>
                ),
            )}
          </nav>
        )
      }
    </div>
  </article>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      url: canonicalUrl,
      author: {
        "@type": "Person",
        name: "Hector Oropesa",
      },
    })}
  />
</Layout>
