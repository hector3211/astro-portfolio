---
import { ArrowUpRight } from "lucide-astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isBlogIndex = pathname.replace(/\/$/, "") === "/blog";
---

<nav
  aria-label="Main navigation"
  class="sticky top-0 z-50 border-b border-border/60 bg-background/95 backdrop-blur"
>
  <div
    class="portfolio-shell flex h-[4.25rem] items-center justify-between gap-4"
  >
    <a
      href="/"
      aria-label="Hector Oropesa, home"
      class="text-lg font-bold tracking-[-0.08em]"
    >
      HO<span class="text-[var(--portfolio-accent)]">.</span>
    </a>
    <div class="flex items-center gap-4 text-sm sm:gap-8">
      <a
        class="text-muted-foreground hover:text-foreground"
        href={isHome ? "#experience" : "/#experience"}>Work</a
      >
      <a
        class="text-muted-foreground hover:text-foreground"
        href={isHome ? "#about" : "/#about"}>About</a
      >
      <a
        class="text-muted-foreground hover:text-foreground aria-[current]:text-[var(--portfolio-accent)]"
        href="/blog"
        aria-current={isBlogIndex
          ? "page"
          : pathname.startsWith("/blog/")
            ? "location"
            : undefined}>Blog</a
      >
      <a
        class="inline-flex items-center gap-1.5 hover:text-[var(--portfolio-accent)]"
        href={isHome ? "#contact" : "/#contact"}
      >
        Let’s talk <ArrowUpRight
          aria-hidden="true"
          class="hidden size-3.5 sm:block"
        />
      </a>
    </div>
  </div>
</nav>
