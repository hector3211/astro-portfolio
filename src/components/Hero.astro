---
import SplineModal from "@/components/SplineModal.tsx";
import { ArrowDown, Mail, MapPin } from "lucide-astro";

const skills = [
  "TypeScript",
  "PostgreSQL",
  "AWS",
  "Terraform",
];

---

<section
  class="mx-auto w-full max-w-screen-xl px-4 pb-12 pt-10 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8"
>
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <div class="mb-8 h-48 w-full max-w-sm overflow-hidden sm:h-64">
      <SplineModal client:only="react" />
    </div>

    <div
      class="inline-flex items-center gap-2 rounded-full border bg-muted/40 px-4 py-2 text-sm text-muted-foreground"
    >
      <MapPin class="h-4 w-4" />
      Software developer based in Florida
    </div>

    <h1 class="mt-7 text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">
      Hector Oropesa
    </h1>
    <p
      class="mt-7 max-w-2xl text-base leading-8 text-muted-foreground sm:text-lg"
    >
      I build software and connect the systems behind it. From APIs and AWS
      infrastructure to servers and workstations, I turn practical problems into
      tools that make work easier.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="#contact"
        class="inline-flex h-12 items-center justify-center gap-2 rounded-none bg-foreground px-5 text-sm font-semibold text-background transition duration-200 hover:bg-foreground/90"
      >
        <Mail class="h-4 w-4" />
        Get in touch
      </a>
      <a
        href="#experience"
        class="inline-flex h-12 items-center justify-center gap-2 rounded-none border bg-background px-5 text-sm font-semibold transition duration-200 hover:bg-muted/50"
      >
        View experience
        <ArrowDown class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-2">
      {
        skills.map((skill) => (
          <span class="rounded-md border bg-muted/60 px-3 py-1 text-xs font-medium text-foreground/85">
            {skill}
          </span>
        ))
      }
    </div>
  </div>

</section>
