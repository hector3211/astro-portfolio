---
import { ArrowDownRight, ArrowUpRight } from "lucide-astro";
---

<section class="editor-intro" aria-labelledby="hero-title">
  <div class="editor-intro-rule" aria-hidden="true">
    <span>README.md</span><span>MARKDOWN</span>
  </div>
  <div class="editor-intro-copy">
    <p class="editor-line editor-comment" data-line="01">
      &lt;!-- software · infrastructure · automation --&gt;
    </p>
    <h1 class="editor-line" data-line="02" id="hero-title">
      <span class="editor-name-word"
        ><span class="editor-heading-token" aria-hidden="true">#</span>{
          " "
        }Hector</span
      >{" "}
      <span class="editor-name-word"
        >Oropesa<span class="editor-period">.</span><span
          class="editor-cursor"
          aria-hidden="true"></span></span
      >
    </h1>
    <div class="editor-intro-meta">
      <p class="editor-line editor-intro-summary" data-line="03">
        I build software and connect the systems behind it, turning practical
        problems into tools that make work easier.
      </p>
      <div class="editor-line editor-intro-links" data-line="04">
        <a href="#experience" class="editor-primary-link"
          >View my work <ArrowDownRight size={17} aria-hidden="true" /></a
        >
        <a href="/blog" class="editor-text-link"
          >Read my notes <ArrowUpRight size={15} aria-hidden="true" /></a
        >
      </div>
    </div>
  </div>
</section>
