---
const technology = [
  {
    label: "Build",
    items: ["TypeScript", "React", "Node.js", "PostgreSQL", "Go", "REST APIs"],
  },
  {
    label: "Automate",
    items: [
      "AWS",
      "Terraform",
      "Ansible",
      "Docker",
      "GitHub Actions",
      "CI/CD",
      "Bash",
      "PowerShell",
    ],
  },
  {
    label: "Connect",
    items: ["Linux", "Proxmox", "Firewalls", "VPNs", "Reverse proxies"],
  },
  {
    label: "Support",
    items: [
      "Microsoft 365",
      "Intune",
      "Entra ID",
      "NinjaOne RMM",
      "ConnectWise",
    ],
  },
];
---

<section
  id="about"
  class="portfolio-shell editor-home-section"
  aria-labelledby="about-title"
>
  <p class="portfolio-label">-- stack.lua</p>
  <header class="portfolio-heading">
    <h2 id="about-title" class="portfolio-title">Tools I work with</h2>
    <p>
      From application code to the infrastructure it depends on, I like making
      the whole system work better.
    </p>
  </header>

  <div class="grid grid-cols-2 gap-x-5 gap-y-9 md:grid-cols-4">
    {
      technology.map((group) => (
        <div>
          <h3 class="portfolio-label mb-4 sm:mb-5">{group.label}</h3>
          <ul class="space-y-1.5 text-sm leading-5 text-foreground/80">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
