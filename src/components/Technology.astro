---
const technology = [
  {
    label: "Build",
    items: ["TypeScript", "React", "Node.js", "PostgreSQL", "Go", "REST APIs"],
  },
  {
    label: "Automate",
    items: [
      "AWS",
      "Terraform",
      "Ansible",
      "Docker",
      "GitHub Actions",
      "CI/CD",
      "Bash",
      "PowerShell",
    ],
  },
  {
    label: "Connect",
    items: ["Linux", "Proxmox", "Firewalls", "VPNs", "Reverse proxies"],
  },
  {
    label: "Support",
    items: [
      "Microsoft 365",
      "Intune",
      "Entra ID",
      "NinjaOne RMM",
      "ConnectWise",
    ],
  },
];
---

<section
  id="about"
  class="portfolio-shell py-20 sm:py-28 lg:py-36"
  aria-labelledby="about-title"
>
  <p class="portfolio-label">
    How I work <span class="text-muted-foreground">/ 02</span>
  </p>
  <header class="portfolio-heading">
    <h2 id="about-title" class="portfolio-title">
      Curious by nature. <span class="block text-muted-foreground"
        >Practical by design.</span
      >
    </h2>
    <p>
      From application code to the infrastructure it depends on, I like making
      the whole system work better.
    </p>
  </header>

  <div class="grid grid-cols-2 gap-x-5 gap-y-9 md:grid-cols-4">
    {
      technology.map((group, index) => (
        <div>
          <h3 class="portfolio-label mb-4 sm:mb-5">
            <span aria-hidden="true" class="mr-1.5">
              {String(index + 1).padStart(2, "0")}{" "}
              <span class="text-muted-foreground">/</span>
            </span>
            {group.label}
          </h3>
          <ul class="space-y-1.5 text-sm leading-5 text-foreground/80">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
