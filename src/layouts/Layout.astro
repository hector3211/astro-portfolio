---
import "@/styles/globals.css";
import "@/styles/portfolio.css";
import "@/styles/editor.css";
import EditorShell from "@/components/EditorShell.astro";
import { Toaster } from "@/components/ui/sonner";

export interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  publishedDate?: string;
  contactToasts?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = "website",
  publishedDate,
  contactToasts = false,
} = Astro.props;

const siteUrl = "https://hectorcodes.dev";
const pageUrl = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
---

<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-Regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {
      publishedDate && ogType === "article" && (
        <meta property="article:published_time" content={publishedDate} />
      )
    }
  </head>
  <body class="portfolio">
    <EditorShell>
      <slot />
    </EditorShell>
    {contactToasts && <Toaster client:load />}
  </body>
</html>
